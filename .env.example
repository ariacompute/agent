# ============================================================================
# Agent Cloud — environment configuration
#
# Copy this file to `.env` and adjust the values, then run:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` for variable substitution (e.g. ${CLOUD_PORT}) and
# the `cloud` service also reads it via `env_file`, so the container process
# receives every variable below directly.
# ============================================================================

# ---- Postgres (metadata store: agents / runs) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent

# ---- Agent Cloud service ----
# Full Postgres connection string. The hostname `postgres` is the compose
# service name and resolves inside the compose network.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/agent

# OpenAI API key for model calls. Leave empty ONLY for stub/offline runs.
OPENAI_API_KEY=

# Memo backend: `memory` (ephemeral, default) or `memo` (persistent sled DB).
# When `memo`, the store is written under MEMO_DIR and survives restarts.
AGENT_MEMO_BACKEND=memory
# Directory for the persistent memo store (used when AGENT_MEMO_BACKEND=memo).
MEMO_DIR=/app/.memo

# API auth gate. When set, every request must carry
# `Authorization: Bearer <key>` (or `ApiKey <key>`). Leave empty to run open.
AGENT_CLOUD_API_KEY=

# Reef stores (records / feedback / git-versioned harness). Persisted via volume.
REEF_DIR=/app/.reef

# Rust log filter: error | warn | info | debug | trace
RUST_LOG=info

# Host port published for the cloud service (the container always listens on 3000).
CLOUD_PORT=3000
