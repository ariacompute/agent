# ============================================================================
# Agent Cloud — environment configuration
#
# Copy this file to `.env` and adjust the values, then run:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` for variable substitution (e.g. ${CLOUD_PORT}) and
# the `cloud` service also reads it via `env_file`, so the container process
# receives every variable below directly.
# ============================================================================

# ---- Postgres + pgvector (metadata: agents / runs AND context: context_fragments) ----
# The image MUST provide the `vector` extension (`pgvector/pgvector:pg16`);
# the cloud refuses to start without it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent

# ---- Agent Cloud service ----
# Full Postgres connection string. The hostname `postgres` is the compose
# service name and resolves inside the compose network.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/agent

# Model backend: the aria-compute gateway (OpenAI-compatible). The cloud reads
# GATEWAY_BASE_URL / GATEWAY_API_KEY / GATEWAY_MODEL — falling back to
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL — to reach it. Leave empty ONLY
# for stub/offline runs.
#
# NOTE: GATEWAY_BASE_URL MUST include the `/v1` prefix — async-openai appends the
# resource path to it, so the final URL becomes GATEWAY_BASE_URL/chat/completions.
GATEWAY_BASE_URL=https://gateway.ariacompute.com/v1
GATEWAY_API_KEY=your-api-key
GATEWAY_MODEL=ariacompute/ariamodel

# Conversational / long-term context is stored in Postgres
# (`context_fragments`, vector(256)) and sharded per principal. No local memo
# backend is configured here.

# API auth gate / bootstrap admin key.
#
# * When SET: it is the bootstrap ADMIN key — present it as
#   `Authorization: Bearer <key>` (or `ApiKey <key>`) to act as Admin.
#   Admin can mint per-tenant keys via `POST /v1/api-keys`. Requests without a
#   valid key (this one or a row in the `api_keys` table) get `401`.
# * When EMPTY: the service runs OPEN — every caller is the `default` tenant.
#
# Per-tenant keys live in the Postgres `api_keys` table (hashed, plaintext shown
# once at creation). See `docs/adr/0007-multi-tenant-api-keys.md`.
AGENT_CLOUD_API_KEY=

# API-key resolution cache TTL (seconds). A resolved key_hash -> principal mapping
# is cached for this long to avoid a Postgres lookup on every request. Revocation
# (`DELETE /v1/api-keys/:id`) purges the cache immediately, so this only bounds
# how long a *missed* purge (e.g. multi-instance) can survive. Default 60.
API_KEY_CACHE_TTL_SEC=60

# Rust log filter: error | warn | info | debug | trace
RUST_LOG=info

# ---- Cloud service ----
# Host port published for DIRECT access to the cloud service (the container
# always listens on 3000). Useful for debugging or when running without nginx:
#   http://localhost:${CLOUD_PORT}/v1/agents
CLOUD_PORT=3000

# ---- Docker sandbox (Engine API, no `docker` CLI in the image) ----
# Endpoint the bollard-backed Docker sandbox connects to. The compose `cloud`
# service mounts the host Docker socket (DooD) and this defaults to it. Override
# with a remote daemon (e.g. tcp://dind:2375) if you prefer Docker-in-Docker or
# a separate host.
DOCKER_HOST=unix:///var/run/docker.sock
# Optional: pin the sandbox socket explicitly, bypassing auto-discovery. Useful on
# macOS (Docker Desktop: ~/.docker/run/docker.sock), Colima or rootless Podman,
# where /var/run/docker.sock does not exist. Leave commented for auto-discovery.
#ARIA_DOCKER_SOCKET=/Users/you/.docker/run/docker.sock
# GID of the host `docker` group that owns /var/run/docker.sock. The runtime
# image creates a group with this GID and adds the non-root `aria` user to it so
# the socket is reachable without running as root. Match the host:
#   stat -c '%g' /var/run/docker.sock   (often 998 or 999)
DOCKER_GID=998

# ---- Sandbox resource limits (apply to Docker, Kata, and best-effort Cube) ----
# Per-tool sandbox cap. Parsed once at startup; invalid values fall back to the
# defaults below (and log a warning) so the service still boots.
#   SANDBOX_CPUS       Logical CPUs (e.g. 1.0, 0.5). -> nano_cpus in the Engine API.
#   SANDBOX_MEMORY     Memory cap, human-readable units (512m, 1g, …). Empty/"b" = bytes.
#   SANDBOX_PIDS_LIMIT Max processes in the sandbox (pids cgroup). Needs pids cgroup support.
# Docker and Kata push these through the Engine API (HostConfig); Cube maps them
# to best-effort `cube` CLI flags (--cpus / --memory) — adjust per your runtime.
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=256

# ---- Reverse proxy ----
# Host port published by the `nginx` service (forwards to cloud:3000). This is
# the public entrypoint for the API: http://localhost:${NGINX_PORT}
NGINX_PORT=80

# ---- CLI config (optional; relates to `aria-agent setup` / `upgrade` / `serve`) ----
# Home dir for the sidecar CLI config (~/.ariacompute/agent-cli.yml) and the
# libaria-agent_ffi install dir (~/.ariacompute/lib). Empty -> ~/.ariacompute.
# This also changes where `upgrade` reads/writes `upgrade_url` and installs the
# cdylib, and where `serve` looks for it.
ARIA_COMPUTE_HOME=
# Override the path native SDKs load libaria-agent_ffi from. When empty,
# `aria-agent serve` points it at ${ARIA_COMPUTE_HOME:-~/.ariacompute}/lib
# (where `upgrade` installs the cdylib). If set here, it takes precedence.
ARIA_AGENT_FFI_LIB=
