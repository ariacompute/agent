# ============================================================================
# Agent Cloud — environment configuration
#
# Copy this file to `.env` and adjust the values, then run:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` for variable substitution (e.g. ${CLOUD_PORT}) and
# the `cloud` service also reads it via `env_file`, so the container process
# receives every variable below directly.
# ============================================================================

# ---- Postgres (metadata store: agents / runs) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent

# ---- Agent Cloud service ----
# Full Postgres connection string. The hostname `postgres` is the compose
# service name and resolves inside the compose network.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/agent

# OpenAI API key for model calls. Leave empty ONLY for stub/offline runs.
OPENAI_API_KEY=

# Memo backend: `memory` (ephemeral, default) or `memo` (persistent sled DB).
# When `memo`, the store is written under MEMO_DIR and survives restarts.
AGENT_MEMO_BACKEND=memory
# Directory for the persistent memo store (used when AGENT_MEMO_BACKEND=memo).
MEMO_DIR=/app/.memo

# API auth gate / bootstrap admin key.
#
# * When SET: it is the bootstrap ADMIN key — present it as
#   `Authorization: Bearer <key>` (or `ApiKey <key>`) to act as Admin.
#   Admin can mint per-tenant keys via `POST /v1/api-keys`. Requests without a
#   valid key (this one or a row in the `api_keys` table) get `401`.
# * When EMPTY: the service runs OPEN — every caller is the `default` tenant.
#
# Per-tenant keys live in the Postgres `api_keys` table (hashed, plaintext shown
# once at creation). See `docs/adr/0007-multi-tenant-api-keys.md`.
AGENT_CLOUD_API_KEY=

# Reef stores (records / feedback / git-versioned harness). Persisted via volume.
# Per-tenant harnesses are isolated under REEF_DIR/tenants/<principal_id>.
REEF_DIR=/app/.reef

# API-key resolution cache TTL (seconds). A resolved key_hash -> principal mapping
# is cached for this long to avoid a Postgres lookup on every request. Revocation
# (`DELETE /v1/api-keys/:id`) purges the cache immediately, so this only bounds
# how long a *missed* purge (e.g. multi-instance) can survive. Default 60.
API_KEY_CACHE_TTL_SEC=60

# Rust log filter: error | warn | info | debug | trace
RUST_LOG=info

# Host port published for the cloud service (the container always listens on 3000).
CLOUD_PORT=3000

# ---- CLI config (optional; relates to `aria-agent setup` / `upgrade` / `serve`) ----
# Home dir for the sidecar CLI config (~/.ariacompute/agent-cli.yml) and the
# libaria-agent_ffi install dir (~/.ariacompute/lib). Empty -> ~/.ariacompute.
# This also changes where `upgrade` reads/writes `upgrade_url` and installs the
# cdylib, and where `serve` looks for it.
ARIA_COMPUTE_HOME=
# Override the path native SDKs load libaria-agent_ffi from. When empty,
# `aria-agent serve` points it at ${ARIA_COMPUTE_HOME:-~/.ariacompute}/lib
# (where `upgrade` installs the cdylib). If set here, it takes precedence.
ARIA_AGENT_FFI_LIB=
