# ============================================================================
# Agent Cloud — environment configuration
#
# Copy this file to `.env` and adjust the values, then run:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` for variable substitution (e.g. ${CLOUD_PORT}) and
# the `cloud` service also reads it via `env_file`, so the container process
# receives every variable below directly.
# ============================================================================

# ---- Postgres + pgvector (metadata: agents / runs AND context: context_fragments) ----
# The image MUST provide the `vector` extension (`pgvector/pgvector:pg16`);
# the cloud refuses to start without it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent

# ---- Agent Cloud service ----
# Full Postgres connection string. The hostname `postgres` is the compose
# service name and resolves inside the compose network.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/agent

# Model backend: the aria-compute gateway (OpenAI-compatible). Both turn
# runtimes (`AGENT_HARNESS=dsh` and `native`) use these same GATEWAY_* values.
# There is no OPENAI_* fallback. Leave empty ONLY for stub/offline runs.
#
# Shared gateway root. Each runtime appends its own API prefix: native uses
# /v1/chat/completions, dsh uses /anthropic/v1/messages.
GATEWAY_BASE_URL=https://gateway.ariacompute.com
GATEWAY_API_KEY=your-api-key
GATEWAY_MODEL=ariacompute/ariamodel

# ---- Turn runtime ----
# `dsh` = DeepSeek Harness (default), `native` = the built-in Rust loop. An
# unknown value fails at boot; `dsh` without an installed runtime fails with an
# install hint instead of silently downgrading.
AGENT_HARNESS=dsh
# Harness executable and the per-tenant/per-session home root (inside the image).
DSH_BIN=/opt/dsh/bin/dsh
# Provider route registered inside dsh. `deepseek-official` is the adapter
# shipped with deepseek-harness-sdk 0.2.x; `openai-compatible` is not registered
# there (override only if your dsh build provides it).
DSH_PROVIDER=deepseek-official
DSH_HOME_ROOT=/app/.aria/dsh
DSH_POOL_MAX=8
DSH_IDLE_TTL_SEC=900
# `redacted_thinking` compatibility. The bundled adapter cannot replay an
# Anthropic `redacted_thinking` block (it accepts it in turn one, then fails
# turn two with UNSUPPORTED_CONTENT). `enable` (the default) routes dsh through a
# loopback proxy that strips the block in both directions while keeping
# `thinking` untouched; `disable` connects straight to the gateway and is only
# safe with a dsh build whose adapter understands redacted thinking. Any other
# value fails at boot.
DSH_THINKING_FILTER=enable
# Approval mode for the dsh child process: `read-only`, `workspace-write`
# (default) or `danger-full-access`. It is the tool-permission ceiling dsh
# applies inside the sandbox, so it must never be wider than the sandbox itself.
DSH_PERMISSION_MODE=workspace-write
# `dsh` uses the GATEWAY_* values above. They are bridged into its allow-listed
# child environment; no separate DEEPSEEK_* variables are read from this file.

# ---- Governed execution (egress boundary, credentials, metering) ----
# Every outbound request crosses one boundary: decide → substitute → record
# (ADR-0025). Defaults below are the closed ones; omit a variable to keep its
# default. There is no silent downgrade: an unusable combination fails at boot.
#
# Enforcement mode:
#   proxy   (default) inject HTTP_PROXY into sandboxes.
#   network remove the sandbox's default route and force traffic through the
#           egress sidecar (needs EGRESS_PROXY_IMAGE + CONTROL_PLANE_URL).
#   off     no interception; refuses to start unless AGENT_ALLOW_UNENFORCED_EGRESS=1
#           is also set (every outbound call is then audited as `unenforced_egress`).
AGENT_EGRESS_ENFORCEMENT=proxy
# Required by `network` (also used to re-create a checkpoint sandbox):
#   AGENT_EGRESS_NETWORK     internal Docker network name (default `aria-egress`)
#   AGENT_EGRESS_PROXY_URL   address reachable from inside a sandbox
#                            (default `http://aria-egress-proxy:8080`)
#   EGRESS_PROXY_IMAGE       sidecar image reference (no default; build it with
#                            `just egress-proxy-image`)
#   CONTROL_PLANE_URL        how the sidecar reaches this service, e.g.
#                            http://cloud:3000
#   EGRESS_PROXY_TOKEN       shared secret; generated per boot when unset
#   EGRESS_PROXY_PEER_TTL_SECS  peer identity cache TTL, seconds (default 10)
#AGENT_EGRESS_NETWORK=aria-egress
#AGENT_EGRESS_PROXY_URL=http://aria-egress-proxy:8080
#EGRESS_PROXY_IMAGE=aria-egress-proxy:local
#CONTROL_PLANE_URL=http://cloud:3000
#EGRESS_PROXY_TOKEN=
#EGRESS_PROXY_PEER_TTL_SECS=10
#AGENT_ALLOW_UNENFORCED_EGRESS=1
AGENT_COMPRESSION=on
AGENT_METERING=on
# JSONL audit sink. Unset disables the audit seam (status reports it as
# unavailable). Retention prunes day files older than N days; `0` keeps them.
AGENT_AUDIT_DIR=
AGENT_AUDIT_RETENTION_DAYS=30
# Idle suspension in seconds; `0` disables it.
AGENT_IDLE_TIMEOUT_SECS=900
# Encrypted-at-rest credential store. Empty -> governance endpoints report it as
# unavailable; there is no plaintext fallback.
AGENT_CREDENTIALS_DIR=
# Name of the environment variable that holds the store passphrase. The
# passphrase itself must come from the process environment (never from this
# file's committed copy).
AGENT_CREDENTIAL_MASTER_KEY_ENV=AGENT_CREDENTIAL_MASTER_KEY
# Credential rotation period in seconds; 0 (default) disables rotation.
AGENT_CREDENTIAL_ROTATE_SECS=0

# Conversational / long-term context is stored in Postgres
# (`context_fragments`, vector(256)) and sharded per principal. No local memo
# backend is configured here.

# API auth gate / bootstrap admin key.
#
# * When SET: it is the bootstrap ADMIN key — present it as
#   `Authorization: Bearer <key>` (or `ApiKey <key>`) to act as Admin.
#   Admin can mint per-tenant keys via `POST /v1/api-keys`. Requests without a
#   valid key (this one or a row in the `api_keys` table) get `401`.
# * When EMPTY: the service runs OPEN — every caller is the `default` tenant.
#
# Per-tenant keys live in the Postgres `api_keys` table (hashed, plaintext shown
# once at creation). See `docs/adr/0007-multi-tenant-api-keys.md`.
#
# CLIENT KEY CONSISTENCY: any client (e.g. the cockpit Android app built with
# `-PagentCloudApiKey=...`) sends this value verbatim as `Authorization: Bearer
# <key>`. It must be a key VALID on THIS server — the same `AGENT_CLOUD_API_KEY`
# below, or a per-tenant key minted via `POST /v1/api-keys` — OR the client must
# send NO key when this is EMPTY (open mode). A key the server does not recognize
# (e.g. a leftover placeholder like `ak_live_x`) gets `401`. Keep this server key
# and every client's key CONSISTENT (same valid key) or BOTH EMPTY.
AGENT_CLOUD_API_KEY=your-api-key

# API-key resolution cache TTL (seconds). A resolved key_hash -> principal mapping
# is cached for this long to avoid a Postgres lookup on every request. Revocation
# (`DELETE /v1/api-keys/:id`) purges the cache immediately, so this only bounds
# how long a *missed* purge (e.g. multi-instance) can survive. Default 60.
API_KEY_CACHE_TTL_SEC=60

# Rust log filter: error | warn | info | debug | trace
RUST_LOG=info

# ---- Cloud service ----
# Host port published for DIRECT access to the cloud service (the container
# always listens on 3000). Useful for debugging or when running without nginx:
#   http://localhost:${CLOUD_PORT}/v1/agents
CLOUD_PORT=3000

# ---- Docker sandbox (Engine API, no `docker` CLI in the image) ----
# Endpoint the bollard-backed Docker sandbox connects to. The compose `cloud`
# service mounts the host Docker socket (DooD) and this defaults to it. Override
# with a remote daemon (e.g. tcp://dind:2375) if you prefer Docker-in-Docker or
# a separate host.
DOCKER_HOST=unix:///var/run/docker.sock
# Optional: pin the sandbox socket explicitly, bypassing auto-discovery. Useful on
# macOS (Docker Desktop: ~/.docker/run/docker.sock), Colima or rootless Podman,
# where /var/run/docker.sock does not exist. Leave commented for auto-discovery.
#ARIA_DOCKER_SOCKET=/Users/you/.docker/run/docker.sock
# GID of the host `docker` group that owns /var/run/docker.sock. The runtime
# image creates a group with this GID and adds the non-root `aria` user to it so
# the socket is reachable without running as root. Match the host:
#   stat -c '%g' /var/run/docker.sock   (often 998 or 999)
DOCKER_GID=998

# ---- Sandbox resource limits (apply to Docker, Kata, and best-effort Cube) ----
# Per-tool sandbox cap. Parsed once at startup; invalid values fall back to the
# defaults below (and log a warning) so the service still boots.
#   SANDBOX_CPUS       Logical CPUs (e.g. 1.0, 0.5). -> nano_cpus in the Engine API.
#   SANDBOX_MEMORY     Memory cap, human-readable units (512m, 1g, …). Empty/"b" = bytes.
#   SANDBOX_PIDS_LIMIT Max processes in the sandbox (pids cgroup). Needs pids cgroup support.
# Docker and Kata push these through the Engine API (HostConfig); Cube maps them
# to best-effort `cube` CLI flags (--cpus / --memory) — adjust per your runtime.
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=256

# ---- Reverse proxy ----
# Host port published by the `nginx` service (forwards to cloud:3000). This is
# the public entrypoint for the API: http://localhost:${NGINX_PORT}
NGINX_PORT=80

# ---- CLI config (optional; relates to `aria-agent setup` / `upgrade` / `serve`) ----
# Home dir for the sidecar CLI config (~/.ariacompute/agent-cli.yml) and the
# libaria-agent_ffi install dir (~/.ariacompute/lib). Empty -> ~/.ariacompute.
# This also changes where `upgrade` reads/writes `upgrade_url` and installs the
# cdylib, and where `serve` looks for it.
ARIA_COMPUTE_HOME=
# Override the path native SDKs load libaria-agent_ffi from. When empty,
# `aria-agent serve` points it at ${ARIA_COMPUTE_HOME:-~/.ariacompute}/lib
# (where `upgrade` installs the cdylib). If set here, it takes precedence.
ARIA_AGENT_FFI_LIB=
