-ignored = [
-    "icu_provider",
-    "openssl-sys",
-    "codex-v8-poc",
-]
-
-[profile.dev]
-# The test profile inherits dev. Keep source locations in ordinary builds;
-# use CARGO_PROFILE_DEV_DEBUG=full (or CARGO_PROFILE_TEST_DEBUG=full) for locals.
-debug = "line-tables-only"
-
-[profile.dev-small]
-inherits = "dev"
-opt-level = 0
-debug = "none"
-strip = "symbols"
-
-[profile.release]
-lto = "thin"
-debug = "line-tables-only"
-split-debuginfo = "off"
-# Keep release binaries symbolicateable until packaging has archived the
-# sidecar symbols and stripped the binaries.
-strip = false
-
-# Balance parallel release code generation against binary size.
-codegen-units = 4
-
-[profile.profiling]
-inherits = "release"
-debug = "full"
-lto = false
-strip = false
-
-[profile.ci-test]
-# Reduce binary size to reduce disk pressure.
-inherits = "test"
-opt-level = 0
