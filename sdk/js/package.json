  "description": "Aria agent SDK — mirrors the OpenAI Agents SDK shape (Agent / run / runStreamed / tool / Session) on top of the aria-agent-cloud beta Agents API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
